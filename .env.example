# GEMINI_API_KEY: Required for Gemini AI API calls and File Search Stores.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TEACHER_PIN: Optional override for Teacher Admin Panel PIN (defaults to 2026 if unset).
TEACHER_PIN=""

# TEACHER_SESSION_SECRET: Optional HMAC signing secret for stateless teacher sessions on Vercel/Cloud Run.
TEACHER_SESSION_SECRET=""
